<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes the Room DB (plain SQLite, so without this wallet data would be restorable in cleartext)
  and the EncryptedSharedPreferences file (its ciphertext is inert without the Keystore key that
  never travels with a backup, but excluding it too is correct belt-and-suspenders) from backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="cpt.db" />
        <exclude domain="database" path="cpt.db-wal" />
        <exclude domain="database" path="cpt.db-shm" />
        <exclude domain="database" path="cpt.db-journal" />
        <exclude domain="sharedpref" path="cpt_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="cpt.db" />
        <exclude domain="database" path="cpt.db-wal" />
        <exclude domain="database" path="cpt.db-shm" />
        <exclude domain="database" path="cpt.db-journal" />
        <exclude domain="sharedpref" path="cpt_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
