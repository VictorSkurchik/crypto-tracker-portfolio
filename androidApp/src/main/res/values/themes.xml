<?xml version="1.0" encoding="utf-8"?>
<!--
  Split light/dark (see values-night/themes.xml) so the window background matches CptTheme's
  actual background before Compose attaches, instead of always flashing light regardless of system
  theme. Builds on the framework's Theme.Material, not Material Components — this app has no
  com.google.android.material dependency; its Material3 usage is entirely via Compose.
-->
<resources>
    <style name="Theme.Cpt" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Mirrors CptTheme's light background token, Color(0xFFFAFAF8). -->
        <item name="android:windowBackground">#FFFAFAF8</item>
    </style>
</resources>
