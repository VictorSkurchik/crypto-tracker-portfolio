# Template for the release signing configuration.
#
# Copy this file to `keystore.properties` (in this same directory,
# androidApp/keystore.properties) and fill in real values. That file is
# git-ignored and must never be committed.
#
# If `keystore.properties` is absent, the `release` build type simply
# builds unsigned (today's behavior) — nothing breaks for anyone who
# hasn't set this up.
#
# IMPORTANT — read before generating a keystore:
# Losing this keystore, or its passwords, means you can never publish an
# update to an app that was released under its identity ever again. Before
# managing a release key by hand, seriously consider enrolling in Google
# Play App Signing instead: you sign your uploads with a simpler "upload
# key" (which CAN be reset/rotated if lost) and Google securely holds the
# real signing key on your behalf. Play App Signing is the modern,
# Google-recommended default for new apps and removes most of the
# permanent-loss risk described above. See:
# https://support.google.com/googleplay/android-developer/answer/9842756
#
# If you still want to manage the release key yourself, generate it with:
#   keytool -genkey -v -keystore release.keystore -alias <yourAlias> \
#     -keyalg RSA -keysize 2048 -validity 10000

# Path to the .jks/.keystore file. Can be absolute, or relative to this
# module's directory (androidApp/).
storeFile=/path/to/release.keystore

# Password protecting the keystore file itself.
storePassword=CHANGE_ME_KEYSTORE_PASSWORD

# The alias identifying the signing key inside the keystore.
keyAlias=CHANGE_ME_KEY_ALIAS

# Password protecting that specific key (can be the same as storePassword,
# but does not have to be).
keyPassword=CHANGE_ME_KEY_PASSWORD
